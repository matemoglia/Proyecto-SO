#!/bin/bash

Integrantes="Moglia Mateo, Melo Augustin, Salaberry Francisco"
opcion=-1

Respuesta=""
Error=""

echo "============================================="
echo "=                                           ="
echo "=            REGISTRO AL SISTEMA            ="
echo "=                                           ="
echo "============================================="

read -p "Ingrese su nombre de usuario: " USUARIO 
if [ -z "$USUARIO" ]; then 
    USUARIO="Invitado" 
fi

while [ "$opcion" -ne 0 ]; do
    clear

    
    echo "============================================================================================="
    echo "Usuario: $USUARIO   |   Sistema: GESTION DE ARCHIVOS   |   Fecha y hora: $(date)" 
    echo "============================================================================================="

   
    echo "MENU DE OPCIONES"
    echo ""
    echo "1) Acciones en Directorios"
    echo "2) Acciones en Archivos"
    echo "3) Acciones sobre el contenido de un archivo"
    echo "4) Cambiar permisos de un archivo o directorio"
    echo "5) Mostrar fecha y hora"
    echo "6) Mostrar calendario"
    echo "7) Archivo de Log"
    echo "0) Salir"
    echo "---------------------------------------------------------------------------------------------"

    
    if [ -n "$Respuesta" ]; then
        echo "$Respuesta"
    else
        echo "(Sin operaciones recientes)"
    fi
    echo "---------------------------------------------------------------------------------------------"

    
    echo "MENSAJES DE ERROR:"
    if [ -n "$Error" ]; then
        echo -e "\e[31m$Error\e[0m"
    else
        echo "Ninguno"
    fi
    echo "================================================================================"

    echo "Integrantes del grupo: $Integrantes"
    echo "================================================================================"

    read -p "Ingrese la opcion que desea seleccionar: " opcion

    Respuesta=""
    Error=""

    case $opcion in
        1)
            echo "--- SUBMENU: ACCIONES EN DIRECTORIOS ---"
            echo "a) Crear directorio"
            echo "b) Eliminar directorio"
            read -p "Seleccione una opcion: " OpcionDirect

            if [ "$OpcionDirect" = "a" ]; then
                read -p "Nombre del directorio a crear: " dir
                if [ -d "$dir" ]; then
                    Error="ERROR: El directorio ya existe."
                else
                    mkdir "$dir"
                    Respuesta="Directorio creado con exito."
                fi

            elif [ "$OpcionDirect" = "b" ]; then
                read -p "Nombre del directorio a borrar: " dir
                if [ -d "$dir" ]; then
                    if rmdir "$dir" 2>/dev/null; then
                        Respuesta="Directorio eliminado."
                    else
                        Error="ERROR: El directorio no esta vacio o no se puede borrar."
                    fi
                else
                    Error="ERROR: El directorio no existe."
                fi
            else
                Error="Opcion no valida."
            fi
            ;;

        2)
            echo "--- SUBMENU: ACCIONES EN ARCHIVOS ---"
            echo "a) Eliminar archivo"
            echo "b) Copiar archivo"
            echo "c) Mover archivo"
            echo "d) Mostrar permisos"
            echo "e) Mostrar archivos de un directorio"
            read -p "Seleccione una opcion: " OpcionArch

            if [ "$OpcionArch" = "a" ]; then
                read -p "Ingrese el nombre del archivo a borrar: " archivo
                if [ -f "$archivo" ]; then
                    rm "$archivo"
                    Respuesta="El archivo fue eliminado con exito."
                else
                    Error="ERROR: El archivo no existe."
                fi

            elif [ "$OpcionArch" = "b" ]; then
                read -p "Ingrese el archivo origen: " origen
                read -p "Ingrese el nombre o ruta de destino para el archivo: " destino
                if [ -f "$origen" ]; then
                    cp "$origen" "$destino"
                    Respuesta="El archivo fue copiado con exito."
                else
                    Error="ERROR: El archivo original no existe."
                fi

            elif [ "$OpcionArch" = "c" ]; then
                read -p "Ingrese el archivo que desea mover: " origen
                read -p "Ingrese el nombre o ruta de destino para el archivo: " destino
                if [ -f "$origen" ]; then
                    mv "$origen" "$destino"
                    Respuesta="El archivo fue movido con exito."
                else
                    Error="ERROR: El archivo original no existe."
                fi

            elif [ "$OpcionArch" = "d" ]; then
                read -p "Ingrese la ruta del archivo que desea ver sus permisos: " archivo
                if [ -f "$archivo" ]; then
                    salida_permisos="Permisos para tu usuario:\n"
                    if [ -r "$archivo" ]; then
                        salida_permisos="${salida_permisos}-LECTURA: SI\n"
                    else
                        salida_permisos="${salida_permisos}-LECTURA: NO\n"
                    fi

                    if [ -w "$archivo" ]; then
                        salida_permisos="${salida_permisos}-ESCRITURA: SI\n"
                    else
                        salida_permisos="${salida_permisos}-ESCRITURA: NO\n"
                    fi

                    if [ -x "$archivo" ]; then
                        salida_permisos="${salida_permisos}-EJECUCION: SI"
                    else
                        salida_permisos="${salida_permisos}-EJECUCION: NO"
                    fi
                    Respuesta="$salida_permisos"
                else
                    Error="ERROR: El archivo no existe."
                fi

            elif [ "$OpcionArch" = "e" ]; then
                read -p "Ingrese la ruta del directorio: " ruta
                if [ -d "$ruta" ]; then
                    Respuesta="Los archivos del directorio que usted ingreso son:\n$(ls "$ruta")"
                else
                    Error="ERROR: La ruta que ingreso no es valida."
                fi
            else
                Error="Opcion no valida."
            fi
            ;;

        3)
            echo "--- SUBMENU: AGENDA ---"

            touch archivo.txt

            echo "a) Guardar sus datos en un archivo"
            echo "b) Ver el contenido completo del archivo"
            echo "c) Ver linea en particular"
            echo "d) Buscar y mostrar informacion de una persona ingresando la CI y campo a mostrar"
            echo "e) Eliminar una linea del archivo segun la CI ingresada"
            echo "f) Modificar el telefono de una persona a traves de su CI"

            read -p "Ingrese la opcion que desea ejecutar, en caso de no requerir ninguna inserte 0: " option

            case $option in
                a)
                    read -p "Ingrese su CI: " ci
                    read -p "Ingrese su nombre: " nombre
                    read -p "Ingrese su apellido: " apellido
                    read -p "Ingrese su telefono: " telefono
                    read -p "Ingrese su fecha de nacimiento: " fechaNacimiento

                    echo "$ci;$nombre;$apellido;$telefono;$fechaNacimiento" >> archivo.txt
                    Respuesta="Datos guardados correctamente."
                    ;;

                b)
                    Respuesta="--- CONTENIDO DE LA AGENDA ---\n$(cat archivo.txt)"
                    ;;

                c)
                    echo "Ingrese desde que linea hasta que linea desea ver."
                    read -p "Linea inicial: " linea1
                    read -p "Linea final: " linea2

                    Respuesta="$(sed -n "${linea1},${linea2}p" archivo.txt)"
                    ;;

                d)
                    read -p "Ingrese CI del usuario: " ci

                    echo "Ingrese el campo que desea ver:"
                    echo "nombre"
                    echo "apellido"
                    echo "telefono"
                    echo "fecha"

                    read -p "Campo: " campo

                    case $campo in
                        nombre)
                            Respuesta="$(grep "^$ci;" archivo.txt | cut -d ";" -f 2)"
                            ;;
                        apellido)
                            Respuesta="$(grep "^$ci;" archivo.txt | cut -d ";" -f 3)"
                            ;;
                        telefono)
                            Respuesta="$(grep "^$ci;" archivo.txt | cut -d ";" -f 4)"
                            ;;
                        fecha)
                            Respuesta="$(grep "^$ci;" archivo.txt | cut -d ";" -f 5)"
                            ;;
                        *)
                            Error="Campo incorrecto."
                            ;;
                    esac
                    ;;

                e)
                    read -p "Ingrese la CI del usuario a eliminar: " usuario

                    if grep -q "^$usuario;" archivo.txt; then
                        grep -v "^$usuario;" archivo.txt > temporal.txt
                        mv temporal.txt archivo.txt
                        Respuesta="El usuario fue eliminado correctamente."
                    else
                        Error="ERROR: La CI no fue encontrada."
                    fi
                    ;;

                f)
                    read -p "Ingrese la CI del usuario: " ci
                    linea_vieja=$(grep "^$ci;" archivo.txt)

                    if [ -n "$linea_vieja" ]; then
                        read -p "Ingrese el nuevo numero de telefono: " nuevoNumero

                        nombre=$(echo "$linea_vieja" | cut -d ";" -f 2)
                        apellido=$(echo "$linea_vieja" | cut -d ";" -f 3)
                        fecha=$(echo "$linea_vieja" | cut -d ";" -f 5)

                        linea_nueva="$ci;$nombre;$apellido;$nuevoNumero;$fecha"

                        grep -v "^$ci;" archivo.txt > temporal.txt
                        echo "$linea_nueva" >> temporal.txt
                        mv temporal.txt archivo.txt

                        Respuesta="El telefono fue modificado correctamente."
                    else
                        Error="ERROR: La CI ingresada no existe."
                    fi
                    ;;

                0)
                    Respuesta="Regresando al menu principal..."
                    ;;

                *)
                    Error="Opcion no valida."
                    ;;
            esac
            ;;

        4)
          	read -p "Ingrese de que archivo desea modificar los permisos: " archivo
		echo "a quien desea darlo los permiso"
		echo "USUARIO/PROPIETARIO 	ingrese u"
		echo "GRUPO 	ingrese g"
		echo "OTROS 	ingrese o"
		echo "TODOS 	ingrese a"
		read usuario

		echo "Permisos para tu usuario (si o no): "
		read -p "PERMISO DE LECTURA :" lectura
		read -p "PERMISO DE ESCRITURA: " escritura
		read -p "PERMISO DE EJECUCION: " ejecucion



		if [ lectura]; then
			echo "-LECTURA: SI"
		else 
			echo "-LECTURA: NO"	
		fi
					
		if [ -w "$archivo" ]; then
			echo "-ESCRITURA: SI"
		else 
			echo "-ESCRITURA: NO"
		fi
				
		if [ -x "$archivo" ]; then
			echo "-EJECUCION: SI"
		else 
			echo "-EJECUCION: NO"
		fi
				

		chmod "$usuario" + "$permisos" "$archivo"
				
					
            ;;

        5)
            dias=$(date +%j)
            dia=$(date +%A)
            mes=$(date +%B)
            ano=$(date +%Y)

            Respuesta="Hoy es $dia de $mes de $ano\nHan pasado $dias dias desde el comienzo del año"
            ;;

        6)
            read -p "Ingrese el dia que desea mostrar (en numero): " dia
            read -p "Ingrese el mes que desea mostrar (en numero): " mes
            read -p "Ingrese el ano que desea mostrar (en numero): " ano

            if [ "$mes" -ge 1 ] && [ "$mes" -le 12 ]; then
                cal_salida=$(cal "$mes" "$ano")
                if echo "$cal_salida" | grep -qw "$dia"; then
                    Respuesta="$cal_salida"
                else
                    Error="El dia es incorrecto"
                fi
            else
                Error="EL MES ES INCORRECTO"
            fi
            ;;

        7)
            #en construccion
            ;;

        0)
            clear
            echo "Saliendo del sistema..."
            exit 0
            ;;

        *)
            Error="Opcion invalida, intente de nuevo."
            ;;
    esac
done
