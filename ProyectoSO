#!/bin/bash 

opcion=-1

while [ "$opcion" -ne 0 ]; do
    echo ""
    echo "==================="
    echo "=      MENU       ="
    echo "==================="
    echo "1. Acciones en Directorios"
    echo "2. Acciones en Archivos"
    echo "3. Acciones sobre el contenido de un archivo"
    echo "4. Cambiar permisos de un archivo o directorio"
    echo "5. Mostrar fecha y hora"
    echo "6. Mostrar calendario"
    echo "7. Archivo de Log"
    echo "0. Salir"
    echo "==================="
    read -p "Ingrese la opcion que desea seleccionar: " opcion

    case $opcion in
        1)
            echo "--- SUBMENU: ACCIONES EN DIRECTORIOS ---"
            echo "a) Crear directorio"
            echo "b) Eliminar directorio"
            read -p "Seleccione una opcion: " OpcionDirect

            if [ "$OpcionDirect" = "a" ]; then
                read -p "Nombre del directorio a crear: " dir
                if [ -d "$dir" ]; then
                    echo "ERROR: El directorio ya existe."
                else
                    mkdir "$dir"
                    echo "Directorio creado con exito."
                fi

            elif [ "$OpcionDirect" = "b" ]; then
                read -p "Nombre del directorio a borrar: " dir
                if [ -d "$dir" ]; then
                    if rmdir "$dir" 2>/dev/null; then
                        echo "Directorio eliminado."
                    else
                        echo "ERROR: El directorio no está vacío o no se puede borrar."
                    fi
                else
                    echo "ERROR: El directorio no existe."
                fi
            else
                echo "Opcion no valida."
            fi
            ;;

        2)
            echo "--- SUBMENU: ACCIONES EN ARCHIVOS ---"
            echo "a) Eliminar archivo"
            echo "b) Copiar archivo"
            echo "c) Mover archivo"
            echo "d) Mostrar permisos"
            echo "e) Mostrar archivos de un directorio"
            read -p "Seleccione una opcion: " OpcionArch

            if [ "$OpcionArch" = "a" ]; then
                read -p "Ingrese el nombre del archivo a borrar: " archivo
                if [ -f "$archivo" ]; then
                    rm "$archivo"
                    echo "El archivo fue eliminado con exito."
                else
                    echo "ERROR: El archivo no existe."
                fi

            elif [ "$OpcionArch" = "b" ]; then
                read -p "Ingrese el archivo origen: " origen
                read -p "Ingrese el nombre o ruta de destino para el archivo: " destino
                if [ -f "$origen" ]; then
                    cp "$origen" "$destino"
                    echo "El archivo fue copiado con exito."
                else
                    echo "ERROR: El archivo original no existe."
                fi

            elif [ "$OpcionArch" = "c" ]; then
                read -p "Ingrese el archivo que desea mover: " origen
                read -p "Ingrese el nombre o ruta de destino para el archivo: " destino
                if [ -f "$origen" ]; then
                    mv "$origen" "$destino"
                    echo "El archivo fue movido con exito."
                else
                    echo "ERROR: El archivo original no existe."
                fi

            elif [ "$OpcionArch" = "d" ]; then
                read -p "Ingrese la ruta del archivo que desea ver sus permisos: " archivo
                if [ -f "$archivo" ]; then
                    echo "Permisos para tu usuario: "
                    if [ -r "$archivo" ]; then
                        echo "-LECTURA: SI"
                    else
                        echo "-LECTURA: NO"
                    fi

                    if [ -w "$archivo" ]; then
                        echo "-ESCRITURA: SI"
                    else
                        echo "-ESCRITURA: NO"
                    fi

                    if [ -x "$archivo" ]; then
                        echo "-EJECUCION: SI"
                    else
                        echo "-EJECUCION: NO"
                    fi
                else
                    echo "ERROR: El archivo no existe."
                fi

            elif [ "$OpcionArch" = "e" ]; then
                read -p "Ingrese la ruta del directorio: " ruta
                if [ -d "$ruta" ]; then
                    echo "Los archivos del directorio que usted ingreso son: "
                    ls "$ruta"
                else
                    echo "ERROR: La ruta que ingreso no es valida."
                fi
            else
                echo "Opcion no valida."
            fi
            ;;

        3)
            echo "--- SUBMENU: AGENDA ---"

            # Crear el archivo si no existe
            touch archivo.txt

            echo "a) Guardar sus datos en un archivo"
            echo "b) Ver el contenido completo del archivo"
            echo "c) Ver linea en particular"
            echo "d) Buscar y mostrar informacion de una persona ingresando la CI y campo a mostrar"
            echo "e) Eliminar una linea del archivo según la CI ingresada"
            echo "f) Modificar el telefono de una persona a traves de su CI"

            read -p "Ingrese la opción que desea ejecutar, en caso de no requerir ninguna inserte 0: " option

            case $option in
                a)
                    read -p "Ingrese su CI: " ci
                    read -p "Ingrese su nombre: " nombre
                    read -p "Ingrese su apellido: " apellido
                    read -p "Ingrese su telefono: " telefono
                    read -p "Ingrese su fecha de nacimiento: " fechaNacimiento

                    echo "$ci;$nombre;$apellido;$telefono;$fechaNacimiento" >> archivo.txt
                    echo "Datos guardados correctamente."
                    ;;

                b)
                    echo "--- CONTENIDO DE LA AGENDA ---"
                    cat archivo.txt
                    ;;

                c)
                    echo "Ingrese desde que línea hasta que linea desea ver."
                    read -p "Linea inicial: " linea1
                    read -p "Linea final: " linea2

                    sed -n "${linea1},${linea2}p" archivo.txt
                    ;;

                d)
                    read -p "Ingrese CI del usuario: " ci

                    echo "Ingrese el campo que desea ver:"
                    echo "nombre"
                    echo "apellido"
                    echo "telefono"
                    echo "fecha"

                    read -p "Campo: " campo

                    case $campo in
                        nombre)
                            grep "^$ci;" archivo.txt | cut -d ";" -f 2
                            ;;
                        apellido)
                            grep "^$ci;" archivo.txt | cut -d ";" -f 3
                            ;;
                        telefono)
                            grep "^$ci;" archivo.txt | cut -d ";" -f 4
                            ;;
                        fecha)
                            grep "^$ci;" archivo.txt | cut -d ";" -f 5
                            ;;
                        *)
                            echo "Campo incorrecto."
                            ;;
                    esac
                    ;;

                e)
                    read -p "Ingrese la CI del usuario a eliminar: " usuario

                    if grep -q "^$usuario;" archivo.txt; then
                        grep -v "^$usuario;" archivo.txt > temporal.txt
                        mv temporal.txt archivo.txt
                        echo "El usuario fue eliminado correctamente."
                    else
                        echo "ERROR: La CI no fue encontrada."
                    fi
                    ;;

                f)
                    read -p "Ingrese la CI del usuario: " ci
                    linea_vieja=$(grep "^$ci;" archivo.txt)

                    if [ -n "$linea_vieja" ]; then
                        read -p "Ingrese el nuevo numero de telefono: " nuevoNumero

                        nombre=$(echo "$linea_vieja" | cut -d ";" -f 2)
                        apellido=$(echo "$linea_vieja" | cut -d ";" -f 3)
                        fecha=$(echo "$linea_vieja" | cut -d ";" -f 5)

                        linea_nueva="$ci;$nombre;$apellido;$nuevoNumero;$fecha"

                        grep -v "^$ci;" archivo.txt > temporal.txt
                        echo "$linea_nueva" >> temporal.txt
                        mv temporal.txt archivo.txt

                        echo "El telefono fue modificado correctamente."
                    else
                        echo "ERROR: La CI ingresada no existe."
                    fi
                    ;;

                0)
                    echo "Regresando al menu principal..."
                    ;;

                *)
                    echo "Opción no valida."
                    ;;
            esac
            ;;

        4)

read -p "Ingrese de que archivo desea modificar los permisos: " archivo
				echo "a quien desea darlo los permiso"
				echo "USUARIO/PROPIETARIO 	ingrese u"
				echo "GRUPO 	ingrese g"
				echo "OTROS 	ingrese o"
				echo "TODOS 	ingrese a"
				read usuario

				echo "Permisos para tu usuario (si o no): "
				read -p "PERMISO DE LECTURA :" lectura
				read -p "PERMISO DE ESCRITURA: " escritura
				read -p "PERMISO DE EJECUCION: " ejecucion



				if [ lectura]; then
					echo "-LECTURA: SI"
				else 
					echo "-LECTURA: NO"	
				fi
					
				if [ -w "$archivo" ]; then
					echo "-ESCRITURA: SI"
				else 
					echo "-ESCRITURA: NO"
				fi
						
				if [ -x "$archivo" ]; then
					echo "-EJECUCION: SI"
				else 
					echo "-EJECUCION: NO"
				fi
				

				chmod "$usuario" + "$permisos" "$archivo"
				
					
				
				








            #en construccion
            ;;

        5)
            dias=$(date +%j)
            dia=$(date +%A)
            mes=$(date +%B)
            ano=$(date +%Y)

            echo "Hoy es $dia de $mes de $ano"
            echo "Han pasado $dias dias desde el comienzo del año"
            ;;

        6)
            read -p "Ingrese el dia que desea mostrar (en numero): " dia
            read -p "Ingrese el mes que desea mostrar (en numero): " mes
            read -p "Ingrese el año que desea mostrar (en numero): " año

            if [ "$mes" -ge 1 ] && [ "$mes" -le 12 ]; then
                if cal "$mes" "$año" | grep -qw "$dia"; then
                    cal "$mes" "$año"
                else
                    echo -e "\e[31mEl dia es incorrecto\e[0m"
                fi
            else
                echo -e "\e[31mEL MES ES INCORRECTO\e[0m"
            fi
            ;;

        7)
		#en construccion				
		;;		
        0)
            echo "Saliendo del sistema..."
            ;;

        *)
            echo "Opcion invalida, intente de nuevo."
            ;;
    esac
done
